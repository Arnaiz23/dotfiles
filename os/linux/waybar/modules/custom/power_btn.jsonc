{
    "custom/power_btn": {
        "format" : "{icon}",
        "format-icons": [""],
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/scripts/power_menu.xml",
        "menu-actions": {
          "shutdown": "shutdown now",
          "reboot": "shutdown -r now",
          "suspend": "systemctl suspend",
          "hibernate": "systemctl hibernate",
          "lock": "hyprlock"
        }
    }
}
